# Copia este archivo a .env y cambia los valores. NUNCA subas .env a GitHub.
DATABASE_URL=sqlite:///./mis_finanzas.db
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto
# Minutos que dura la sesión. 10080 = 7 días (cómodo para usarla desde el celular)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MONEDA_POR_DEFECTO=COP
# desarrollo | produccion (en produccion se exige un SECRET_KEY seguro)
ENTORNO=desarrollo
